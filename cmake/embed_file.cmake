# Writes a file's bytes into a C++ source, as the body of a function that returns them, so that a
# program carries the file inside it. C++23 has no #embed.
#
#   cmake -D INPUT=<file> -D OUTPUT=<file.cpp> -D HEADER=<header> -D FUNCTION=<namespace>::<name>
#         -P cmake/embed_file.cmake
#
#   INPUT     the file to embed
#   OUTPUT    the source to write
#   HEADER    the header that declares the function, included as "<header>"
#   FUNCTION  the function, declared there as `std::span<const unsigned char> <name>()`
cmake_minimum_required(VERSION 4.4)

foreach(variable IN ITEMS INPUT OUTPUT HEADER FUNCTION)
    if(NOT ${variable})
        message(FATAL_ERROR "embed_file.cmake needs INPUT, OUTPUT, HEADER and FUNCTION.")
    endif()
endforeach()
if(NOT FUNCTION MATCHES "^(.+)::([^:]+)$")
    message(FATAL_ERROR "FUNCTION names a function in a namespace, not: ${FUNCTION}")
endif()
set(namespace "${CMAKE_MATCH_1}")
set(name "${CMAKE_MATCH_2}")

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
if(size EQUAL 0)
    message(FATAL_ERROR "${INPUT} is empty.")
endif()
# Sixteen bytes to a line, each line indented as clang-format would.
string(REGEX REPLACE "(..)" "0x\\1, " bytes "${hex}")
string(REGEX REPLACE "((0x.., ){16})" "\\1\n" bytes "${bytes}")
string(REGEX REPLACE " \n" "\n    " bytes "    ${bytes}")
string(REGEX REPLACE "[ \n]+$" "" bytes "${bytes}")

cmake_path(GET INPUT FILENAME input_name)
file(WRITE "${OUTPUT}" "// Generated by cmake/embed_file.cmake from ${input_name}. Don't edit it.

#include \"${HEADER}\"

#include <array>
#include <span>

namespace ${namespace} {
namespace {

constexpr std::array<unsigned char, ${size}> bytes{
${bytes}
};

} // namespace

std::span<const unsigned char> ${name}() {
    return bytes;
}

} // namespace ${namespace}
")
