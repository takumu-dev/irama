{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/master/Help/manual/presets/schema.json",
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "$comment": "Every preset builds with Ninja and takes its dependencies from vcpkg, found through VCPKG_ROOT.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "windows",
      "$comment": "Run from a developer command prompt for MSVC 14.52 or newer, which puts cl on the PATH and picks the architecture.",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": ["gcc", "debug"],
      "displayName": "GCC, debug"
    },
    {
      "name": "gcc-release",
      "inherits": ["gcc", "release"],
      "displayName": "GCC, release"
    },
    {
      "name": "clang-debug",
      "inherits": ["clang", "debug"],
      "displayName": "Clang with libstdc++, debug"
    },
    {
      "name": "clang-release",
      "inherits": ["clang", "release"],
      "displayName": "Clang with libstdc++, release"
    },
    {
      "name": "msvc-debug",
      "inherits": ["msvc", "debug"],
      "displayName": "MSVC, debug"
    },
    {
      "name": "msvc-release",
      "inherits": ["msvc", "release"],
      "displayName": "MSVC, release"
    },
    {
      "name": "clang-asan",
      "inherits": ["clang", "debug"],
      "displayName": "Clang, debug, AddressSanitizer and UndefinedBehaviorSanitizer",
      "description": "libirama, irama-cli and the tests are instrumented. The dependencies aren't, which AddressSanitizer on Linux doesn't need.",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "clang-rtsan",
      "inherits": ["clang", "debug"],
      "displayName": "Clang, debug, RealtimeSanitizer",
      "description": "Every function marked IRAMA_NONBLOCKING stops the program at the first allocation, lock, system call or other real-time unsafe call it makes.",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=realtime",
        "CMAKE_CXX_FLAGS": "-fsanitize=realtime",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=realtime"
      }
    },
    {
      "name": "gcc-libirama",
      "inherits": ["gcc", "release"],
      "displayName": "GCC, release, libirama alone",
      "description": "Every part but libirama switched off, so vcpkg installs only libirama's own dependencies, as a game building it would see.",
      "cacheVariables": {
        "IRAMA_BUILD_CLI": false,
        "IRAMA_BUILD_TESTS": false
      }
    },
    {
      "name": "lint",
      "inherits": ["gcc", "debug"],
      "displayName": "Formatting and documentation",
      "description": "Checks the formatting with clang-format and the documentation of the public headers with Doxygen, building nothing else.",
      "cacheVariables": {
        "IRAMA_BUILD_CLI": false,
        "IRAMA_BUILD_TESTS": false
      }
    },
    {
      "name": "tidy",
      "inherits": ["clang", "debug"],
      "displayName": "clang-tidy",
      "description": "Builds every part with clang-tidy run on every C++ source.",
      "cacheVariables": {
        "IRAMA_BUILD_CLI": true,
        "IRAMA_BUILD_TESTS": true,
        "IRAMA_CLANG_TIDY": true
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "clang-asan", "configurePreset": "clang-asan" },
    { "name": "clang-rtsan", "configurePreset": "clang-rtsan" },
    { "name": "gcc-libirama", "configurePreset": "gcc-libirama" },
    { "name": "lint", "configurePreset": "lint", "targets": ["check-format", "docs"] },
    { "name": "tidy", "configurePreset": "tidy" }
  ],
  "testPresets": [
    {
      "name": "test",
      "hidden": true,
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "junit.xml"
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    { "name": "gcc-debug", "inherits": "test", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "inherits": "test", "configurePreset": "gcc-release" },
    { "name": "clang-debug", "inherits": "test", "configurePreset": "clang-debug" },
    { "name": "clang-release", "inherits": "test", "configurePreset": "clang-release" },
    { "name": "msvc-debug", "inherits": "test", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "inherits": "test", "configurePreset": "msvc-release" },
    { "name": "clang-asan", "inherits": "test", "configurePreset": "clang-asan" },
    { "name": "clang-rtsan", "inherits": "test", "configurePreset": "clang-rtsan" }
  ],
  "workflowPresets": [
    {
      "name": "gcc-debug",
      "steps": [
        { "type": "configure", "name": "gcc-debug" },
        { "type": "build", "name": "gcc-debug" },
        { "type": "test", "name": "gcc-debug" }
      ]
    },
    {
      "name": "gcc-release",
      "steps": [
        { "type": "configure", "name": "gcc-release" },
        { "type": "build", "name": "gcc-release" },
        { "type": "test", "name": "gcc-release" }
      ]
    },
    {
      "name": "clang-debug",
      "steps": [
        { "type": "configure", "name": "clang-debug" },
        { "type": "build", "name": "clang-debug" },
        { "type": "test", "name": "clang-debug" }
      ]
    },
    {
      "name": "clang-release",
      "steps": [
        { "type": "configure", "name": "clang-release" },
        { "type": "build", "name": "clang-release" },
        { "type": "test", "name": "clang-release" }
      ]
    },
    {
      "name": "msvc-debug",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "msvc-debug" },
        { "type": "test", "name": "msvc-debug" }
      ]
    },
    {
      "name": "msvc-release",
      "steps": [
        { "type": "configure", "name": "msvc-release" },
        { "type": "build", "name": "msvc-release" },
        { "type": "test", "name": "msvc-release" }
      ]
    },
    {
      "name": "clang-asan",
      "steps": [
        { "type": "configure", "name": "clang-asan" },
        { "type": "build", "name": "clang-asan" },
        { "type": "test", "name": "clang-asan" }
      ]
    },
    {
      "name": "clang-rtsan",
      "steps": [
        { "type": "configure", "name": "clang-rtsan" },
        { "type": "build", "name": "clang-rtsan" },
        { "type": "test", "name": "clang-rtsan" }
      ]
    },
    {
      "name": "gcc-libirama",
      "steps": [
        { "type": "configure", "name": "gcc-libirama" },
        { "type": "build", "name": "gcc-libirama" }
      ]
    },
    {
      "name": "lint",
      "steps": [
        { "type": "configure", "name": "lint" },
        { "type": "build", "name": "lint" }
      ]
    },
    {
      "name": "tidy",
      "steps": [
        { "type": "configure", "name": "tidy" },
        { "type": "build", "name": "tidy" }
      ]
    }
  ]
}
